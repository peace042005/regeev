{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card"><div class="card-body">
                <h1 class="h4 mb-3">Connexion</h1>

                {% if error %}
                    <div class="alert alert-danger" role="alert">Adresse e-mail ou mot de passe incorrect.</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label" for="username">Adresse e-mail</label>
                        <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Mot de passe</label>
                        <input class="form-control" type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-regeev w-100" type="submit">Se connecter</button>
                </form>

                <hr>
                <p class="small mb-0">
                    Pas encore de compte ?
                    <a href="{{ path('app_register_commerce') }}">Commerce</a> ·
                    <a href="{{ path('app_register_association') }}">Association</a>
                </p>
            </div></div>
        </div>
    </div>
{% endblock %}
