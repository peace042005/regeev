<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ReGeev{% endblock %} · Dons d'invendus alimentaires</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --regeev: #1f7a4d; }
        .navbar-brand { font-weight: 700; color: var(--regeev) !important; }
        .btn-regeev { background: var(--regeev); color: #fff; }
        .btn-regeev:hover { background: #17603c; color: #fff; }
        .chiffre { font-size: 2.2rem; font-weight: 700; color: var(--regeev); }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-md bg-white border-bottom">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">ReGeev</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_impact') }}">Notre impact</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin') }}">Administration</a></li>
                {% endif %}
                {% if is_granted('ROLE_ASSOCIATION') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_catalogue') }}">Lots disponibles</a></li>
                {% endif %}
            </ul>
            <ul class="navbar-nav">
                {% if app.user %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_espace') }}">Mon espace</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a></li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Connexion</a></li>
                    <li class="nav-item"><a class="btn btn-regeev btn-sm ms-md-2 mt-1" href="{{ path('app_register_commerce') }}">Je suis un commerce</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4 flex-grow-1">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="border-top bg-white py-3 text-center text-muted small">
    ReGeev — projet réalisé par Marcella Chanhoun · Symfony, PostgreSQL, Bootstrap
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
