{% extends 'base.html.twig' %}

{% block title %}{{ lot.id ? 'Modifier le lot' : 'Nouveau lot' }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card"><div class="card-body">
                <h1 class="h4 mb-3">{{ lot.id ? 'Modifier le lot' : 'Publier un lot d\'invendus' }}</h1>
                {{ form_start(form) }}
                    {{ form_row(form.titre) }}
                    {{ form_row(form.categorie) }}
                    {{ form_row(form.description) }}
                    <div class="row">
                        <div class="col-sm-4">{{ form_row(form.quantite) }}</div>
                        <div class="col-sm-4">{{ form_row(form.unite) }}</div>
                        <div class="col-sm-4">{{ form_row(form.poidsKg) }}</div>
                    </div>
                    {{ form_row(form.dateLimite) }}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.retraitDebut) }}</div>
                        <div class="col-sm-6">{{ form_row(form.retraitFin) }}</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-regeev" type="submit">Enregistrer le brouillon</button>
                        <a class="btn btn-outline-secondary" href="{{ lot.id ? path('app_lot_show', {id: lot.id}) : path('app_espace') }}">Retour</a>
                    </div>
                {{ form_end(form) }}
            </div></div>
        </div>
    </div>
{% endblock %}
