{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Bonjour {{ app.user.nom }}</h1>

    {% if commerce %}
        <p class="text-muted">{{ commerce.adresse }}, {{ commerce.codePostal }} {{ commerce.ville }} · SIRET {{ commerce.siret }}</p>

        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-2 gap-2">
            <h2 class="h5 mb-0">Mes derniers lots</h2>
            <a class="btn btn-regeev btn-sm" href="{{ path('app_lot_new') }}">+ Publier un lot</a>
        </div>

        {% if lots is empty %}
            <p>Vous n'avez pas encore publié de lot.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm bg-white align-middle">
                    <thead><tr><th>Titre</th><th>Catégorie</th><th>Poids</th><th>Date limite</th><th>Statut</th></tr></thead>
                    <tbody>
                    {% for lot in lots %}
                        <tr>
                            <td><a href="{{ path('app_lot_show', {id: lot.id}) }}">{{ lot.titre }}</a></td>
                            <td>{{ lot.categorie }}</td>
                            <td>{{ lot.poidsKg|number_format(1, ',', ' ') }} kg</td>
                            <td>{{ lot.dateLimite|date('d/m/Y') }}</td>
                            <td>{{ include('_statut.html.twig', {statut: lot.statut}) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% elseif association %}
        <p class="text-muted">{{ association.adresse }}, {{ association.codePostal }} {{ association.ville }} · RNA {{ association.rna }}</p>

        {% if not association.validated %}
            <div class="alert alert-warning" role="alert">
                Votre association est en attente de validation par un administrateur.
            </div>
        {% endif %}

        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-2 gap-2">
            <h2 class="h5 mb-0">Mes dernières réservations</h2>
            <a class="btn btn-regeev btn-sm" href="{{ path('app_catalogue') }}">Voir les lots disponibles</a>
        </div>
        {% if reservations is empty %}
            <p>Vous n'avez pas encore de réservation.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm bg-white align-middle">
                    <thead><tr><th>Lot</th><th>Commerce</th><th>Réservé le</th><th>Code de retrait</th><th>Statut</th><th></th></tr></thead>
                    <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>{{ reservation.lot.titre }}</td>
                            <td>{{ reservation.lot.commerce.nom }}</td>
                            <td>{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                            <td><code>{{ reservation.codeRetrait }}</code></td>
                            <td>{{ include('_statut.html.twig', {statut: reservation.statut}) }}</td>
                            <td class="text-end">
                                {% if reservation.statut == 'active' %}
                                    <form method="post" action="{{ path('app_reservation_cancel', {id: reservation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reservation' ~ reservation.id) }}">
                                        <button class="btn btn-outline-danger btn-sm" type="submit">Annuler la réservation</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% else %}
        <p>Bienvenue dans l'espace d'administration (à venir : validation des associations et modération).</p>
    {% endif %}
{% endblock %}
