# Valeurs par défaut pour le développement local.
# Ne JAMAIS mettre de vrais secrets ici : utiliser .env.local (non versionné)
# ou les variables d'environnement de l'hébergeur en production.
APP_ENV=dev
APP_SECRET=change-me-en-local-0123456789abcdef

# PostgreSQL lancé avec `docker compose up -d`
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/regeev?serverVersion=16&charset=utf8"
